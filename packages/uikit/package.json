{
  "name": "@easemob/uikit",
  "version": "1.3.0",
  "description": "Easemob UIKit Vue3 Components",
  "type": "module",
  "main": "./dist/easemob-uikit.umd.cjs",
  "module": "./dist/easemob-uikit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/easemob-uikit.js",
      "require": "./dist/easemob-uikit.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./resolver": {
      "import": "./dist/resolver.js",
      "types": "./dist/resolver.d.ts"
    },
    "./auto-imports": {
      "import": "./dist/auto-imports.js",
      "types": "./dist/auto-imports.d.ts"
    },
    "./theme": "./dist/theme/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "story:dev": "histoire dev",
    "story:build": "histoire build"
  },
  "peerDependencies": {
    "pinia": "^2.1.0",
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@tiptap/vue-3": "^3.22.5",
    "@vueuse/core": "^14.3.0",
    "easemob-websdk": "file:../../easemob-websdk-next-0.14.161.tgz"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "^0.17.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "histoire": "^0.17.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vue": "^3.3.0",
    "vue-tsc": "^2.0.0"
  }
}
