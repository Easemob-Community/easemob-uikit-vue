{
  "name": "@easemob/uikit",
  "version": "1.3.1",
  "description": "Easemob UIKit Vue3 Components",
  "type": "module",
  "main": "./dist/easemob-uikit.umd.cjs",
  "module": "./dist/easemob-uikit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/easemob-uikit.js",
      "require": "./dist/easemob-uikit.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./resolver": {
      "import": "./dist/resolver.js",
      "types": "./dist/resolver.d.ts"
    },
    "./auto-imports": {
      "import": "./dist/auto-imports.js",
      "types": "./dist/auto-imports.d.ts"
    },
    "./theme": "./dist/theme/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/check-icon-refs.mjs && vite build && vite build --config vite.aux.config.ts && vue-tsc --emitDeclarationOnly --project tsconfig.build.json",
    "dev": "vite build --watch",
    "icons:check": "node scripts/check-icon-refs.mjs",
    "story:dev": "histoire dev",
    "story:build": "histoire build"
  },
  "peerDependencies": {
    "pinia": "^2.1.0",
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "@tiptap/vue-3": "^3.30.0",
    "@vueuse/core": "^14.4.0",
    "easemob-websdk": "^5.0.0"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "^0.17.17",
    "@vitejs/plugin-vue": "^4.6.2",
    "histoire": "^0.17.17",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.9.1",
    "vue": "^3.5.41",
    "vue-tsc": "^2.2.12"
  }
}
