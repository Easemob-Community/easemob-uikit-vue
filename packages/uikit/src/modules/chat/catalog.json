      "scene": "消息气泡上的已送达回执状态图标",
      "mapping": { "category": "status", "file": "received@3x.png" }
    },
    {
      "feature": "消息发送中",
      "scene": "消息气泡上的发送中状态图标",
      "mapping": { "category": "status", "file": "sending@3x.png" }
    },
    {
      "feature": "消息已发送",
      "scene": "消息气泡上的已发送状态图标",
      "mapping": { "category": "status", "file": "sent@3x.png" }
    },
    {
      "feature": "消息发送失败",
      "scene": "消息气泡上的发送失败状态图标",
      "mapping": { "category": "status", "file": "failed@3x.png" }
    },
    {
      "feature": "新消息提示",
      "scene": "消息列表底部新消息提示的向下箭头图标",
      "mapping": { "category": "arrows", "file": "arrow_down_thick.svg" },
      "alternatives": [{ "category": "arrows", "file": "arrow_down_thin.svg" }]
    },
    {
      "feature": "@提及",
      "scene": "输入框@提及功能的人物/提及图标",
      "mapping": { "category": "people", "file": "mention.svg" },
      "alternatives": [{ "category": "people", "file": "people_tag.svg" }],
      "note": "如 people 分类下无 mention 图标，可用 people_tag 或 at 相关图标替代"
    },
    {
      "feature": "引用消息",
      "scene": "右键/长按菜单中的「引用」操作图标",
      "mapping": { "category": "chat", "file": "quote.svg" },
      "alternatives": [{ "category": "arrows", "file": "arrow_Uturn_anti_clockwise.svg" }]
    },
    {
      "feature": "复制消息",
      "scene": "右键/长按菜单中的「复制」操作图标",
      "mapping": { "category": "actions", "file": "copy.svg" },
      "note": "如 actions 分类下无 copy 图标，可用 misc/copy 或文档类图标替代"
    },
    {
      "feature": "删除消息",
      "scene": "右键/长按菜单中的「删除」操作图标",
      "mapping": { "category": "actions", "file": "trash.svg" },
      "alternatives": [{ "category": "actions", "file": "trashdelete.svg" }]
    },
    {
      "feature": "撤回消息",
      "scene": "右键/长按菜单中的「撤回」操作图标",
      "mapping": { "category": "arrows", "file": "arrow_Uturn_anti_clockwise.svg" },
      "alternatives": [{ "category": "arrows", "file": "arrow_Uturn_clockwise.svg" }]
    },
    {
      "feature": "转发消息",
      "scene": "右键/长按菜单中的「转发」操作图标",
      "mapping": { "category": "arrows", "file": "arrow_n_line.svg" },
      "note": "转发可使用箭头相关图标"
    },
    {
      "feature": "多选消息",
      "scene": "右键/长按菜单中的「多选」操作图标",
      "mapping": { "category": "actions", "file": "checked_ellipse.svg" },
      "alternatives": [{ "category": "actions", "file": "check.svg" }]
    },
    {
      "feature": "翻译消息",
      "scene": "右键/长按菜单中的「翻译」操作图标",
      "mapping": { "category": "misc", "file": "language.svg" },
      "note": "如 misc 分类下无 language 图标，可用地球/文本相关图标替代"
    },
    {
      "feature": "置顶消息",
      "scene": "右键/长按菜单中的「置顶」操作图标",
      "mapping": { "category": "chat", "file": "pin.svg" },
      "alternatives": [{ "category": "arrows", "file": "line_n_arrow.svg" }]
    },
    {
      "feature": "多选转发",
      "scene": "多选模式底部操作栏的转发按钮图标",
      "mapping": { "category": "chat", "file": "forward.svg" },
      "alternatives": [{ "category": "arrows", "file": "arrow_n_line.svg" }]
    },
    {
      "feature": "多选删除",
