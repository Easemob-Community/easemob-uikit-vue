{
  "module": "chat",
  "description": "聊天模块所需图标映射，关联 src/assets/icons 下的实际资源文件",
  "iconUsage": [
    {
      "feature": "返回箭头",
      "scene": "聊天信息抽屉的返回按钮",
      "mapping": { "category": "arrows", "file": "arrow_left_thick.svg" }
    },
    {
      "feature": "编辑备注",
      "scene": "聊天信息抽屉中编辑备注的图标",
      "mapping": { "category": "misc", "file": "edit.svg" }
