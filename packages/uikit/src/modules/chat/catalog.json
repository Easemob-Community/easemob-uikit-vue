    },
    {
      "feature": "关闭预览",
      "scene": "视频全屏预览的关闭按钮图标",
      "mapping": { "category": "actions", "file": "close.svg" },
      "alternatives": [{ "category": "actions", "file": "xmark_thick.svg" }]
