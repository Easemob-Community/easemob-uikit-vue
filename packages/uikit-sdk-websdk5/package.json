{
  "name": "@easemob/uikit-sdk-websdk5",
  "type": "module",
  "version": "1.0.0",
  "description": "Easemob UIKit SDK adapter for easemob-websdk 5.x (client / domain / event / adapter implementation)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/easemob-uikit-sdk-websdk5.js",
      "require": "./dist/easemob-uikit-sdk-websdk5.umd.cjs"
    }
  },
  "main": "./dist/easemob-uikit-sdk-websdk5.umd.cjs",
  "module": "./dist/easemob-uikit-sdk-websdk5.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly --project tsconfig.build.json",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "pinia": "^2.1.0 || ^4.0.0",
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@easemob/uikit-sdk-contract": "workspace:*",
    "@easemob/uikit-core": "workspace:*",
    "easemob-websdk": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.9.1",
    "vue": "^3.5.41",
    "vue-tsc": "^2.2.12"
  }
}
