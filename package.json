{
  "name": "easemob-uikit-vue",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "description": "Easemob UIKit for Vue3",
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "@easemob/uikit-im>@easemob/uikit-core": "file:./easemob-uikit-core-2.8.3.tgz",
      "@easemob/uikit-im>@easemob/uikit-sdk-contract": "file:./easemob-uikit-sdk-contract-1.2.1.tgz",
      "@easemob/uikit-core>@easemob/uikit-sdk-contract": "file:./easemob-uikit-sdk-contract-1.2.1.tgz"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -F @easemob/uikit-im story:dev",
    "dev:demo": "pnpm -F @easemob/demo dev",
    "dev:demo-chatroom": "pnpm -F @easemob/demo-chatroom dev",
    "sdk:use-tgz": "node scripts/switch-sdk.mjs tgz",
    "sdk:use-npm": "node scripts/switch-sdk.mjs npm",
    "sdk:status": "node scripts/switch-sdk.mjs status",
    "sdk:up": "pnpm up easemob-websdk",
    "adapter:isolation": "node packages/uikit-im/scripts/check-sdk-isolation.mjs && node packages/uikit-sdk-websdk5/scripts/check-reverse-dependency.mjs && node packages/uikit-sdk-webim4/scripts/check-reverse-dependency.mjs",
    "test": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "changelog:check": "node scripts/check-version-sync.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.27.3",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.57.1",
    "eslint-plugin-format": "^2.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1",
    "vue-tsc": "^2.2.12"
  }
}
