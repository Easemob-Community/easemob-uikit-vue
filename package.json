{
  "name": "easemob-uikit-vue",
  "private": true,
  "version": "1.0.0",
  "description": "Easemob UIKit for Vue3",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -F @easemob/uikit story:dev",
    "sdk:use-tgz": "node scripts/switch-sdk.mjs tgz",
    "sdk:use-npm": "node scripts/switch-sdk.mjs npm",
    "sdk:status": "node scripts/switch-sdk.mjs status",
    "sdk:up": "pnpm up easemob-websdk",
    "test": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.27.3",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.55.0",
    "eslint-plugin-format": "^2.0.1",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "vue-tsc": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
