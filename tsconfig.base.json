{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@easemob-community/uikit-core": ["./packages/uikit-core/src"],
      "@easemob-community/uikit-core/*": ["./packages/uikit-core/src/*"],
      "@easemob-community/uikit-sdk-contract": ["./packages/uikit-sdk-contract/src"],
      "@easemob-community/uikit-sdk-contract/*": ["./packages/uikit-sdk-contract/src/*"],
      "@easemob-community/uikit-sdk-websdk5": ["./packages/uikit-sdk-websdk5/src"],
      "@easemob-community/uikit-sdk-websdk5/*": ["./packages/uikit-sdk-websdk5/src/*"],
      "@easemob-community/uikit-sdk-webim4": ["./packages/uikit-sdk-webim4/src"],
      "@easemob-community/uikit-sdk-webim4/*": ["./packages/uikit-sdk-webim4/src/*"],
      "@easemob-community/uikit-im": ["./packages/uikit-im/src"],
      "@easemob-community/uikit-im/*": ["./packages/uikit-im/src/*"],
      "@easemob-community/uikit-chatroom": ["./packages/uikit-chatroom/src"],
      "@easemob-community/uikit-chatroom/*": ["./packages/uikit-chatroom/src/*"]
    }
  },
  "include": ["packages/*/src", "apps/*/src"],
  "exclude": ["node_modules", "dist"]
}
