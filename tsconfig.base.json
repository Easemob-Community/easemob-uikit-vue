{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@easemob/uikit-core": ["./packages/uikit-core/src"],
      "@easemob/uikit-core/*": ["./packages/uikit-core/src/*"],
      "@easemob/uikit-im": ["./packages/uikit-im/src"],
      "@easemob/uikit-im/*": ["./packages/uikit-im/src/*"],
      "@easemob/uikit-chatroom": ["./packages/uikit-chatroom/src"],
      "@easemob/uikit-chatroom/*": ["./packages/uikit-chatroom/src/*"]
    }
  },
  "include": ["packages/*/src", "apps/*/src"],
  "exclude": ["node_modules", "dist"]
}
